{
  // Core must stay pure: no DOM, no audio, no Node. Type-checking it without
  // those libs turns any stray `window`, `AudioContext` or `console` into an error.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core"]
}
